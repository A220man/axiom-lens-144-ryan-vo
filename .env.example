# Application
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# LLM Provider (choose one)
# Options: custom, openai, anthropic, gemini, ollama
LLM_PROVIDER=custom
LLM_API_KEY=
LLM_MODEL=gemma4-e4b
LLM_BASE_URL=http://localhost:8080/v1

# Keycloak OIDC
KEYCLOAK_URL=http://localhost:8081
KEYCLOAK_REALM=axiom-lens
KEYCLOAK_CLIENT_ID=axiom-lens-client
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Database
DATABASE_URL=sqlite:///./axiom_lens.db

# Device
ADB_HOST=127.0.0.1
ADB_PORT=5037
ARTEMIS_ALLOW_REMOTE_ADB_CONFIGURATION=false

# Frontend
VITE_API_URL=http://localhost:8000
VITE_KEYCLOAK_URL=http://localhost:8081
VITE_KEYCLOAK_REALM=axiom-lens
VITE_KEYCLOAK_CLIENT_ID=axiom-lens-client
